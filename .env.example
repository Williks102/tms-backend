APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# file, PAS database — Neon (plan gratuit) coupe les connexions inactives,
# et depuis la migration Sanctum SPA la session EST le mécanisme d'auth : une
# session qui échoue à se lire/écrire bloque l'authentification de toute
# l'app, pas juste une requête isolée. Voir CLAUDE.md § Auth.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Topologie de prod retenue : sous-domaines d'un même domaine racine (ex.
# app.tms-ci.com + api.tms-ci.com — voir CLAUDE.md § Auth). SESSION_SAME_SITE
# reste "lax" (deux sous-domaines d'un domaine commun sont "same-site"), il
# suffit de passer SESSION_SECURE_COOKIE=true (HTTPS) et de renseigner
# SESSION_DOMAIN=.tms-ci.com au déploiement.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

SANCTUM_STATEFUL_DOMAINS=localhost:3000
SANCTUM_TOKEN_EXPIRATION=720
FRONTEND_URL=http://localhost:3000

# Paiement en ligne (achat billet /billets) — voir Services/Payments/PaiementProService (SOAP)
PAIEMENTPRO_MERCHANT_ID=
PAIEMENTPRO_BASE_URL=https://www.paiementpro.net

# CAPTCHA Cloudflare Turnstile (/mes-achats) — voir correctif.md point 7 et
# Services/Security/TurnstileService. Vide = vérification court-circuitée en
# dev, à renseigner avant mise en prod (voir aussi NEXT_PUBLIC_TURNSTILE_SITE_KEY
# côté frontend).
TURNSTILE_SECRET_KEY=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
